#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
log(){ printf '[release-gate] %s\n' "$*"; }
pass(){ printf '[release-gate][+] %s\n' "$*"; }
fail(){ printf '[release-gate][X] %s\n' "$*" >&2; exit 1; }
command -v cargo >/dev/null || fail "cargo not found"
log "format check"; cargo fmt --all -- --check; pass "format"
log "clippy"; cargo clippy --workspace --all-targets --all-features -- -D warnings; pass "clippy"
log "workspace tests"; cargo test --workspace --all-targets; pass "workspace tests"
[[ -x "$ROOT/validation/run_tsan.sh" ]] || fail "validation/run_tsan.sh missing or not executable"
log "ThreadSanitizer"; "$ROOT/validation/run_tsan.sh"; pass "ThreadSanitizer"
log "full FFI release build"; cargo build -p shawncore-ffi --release; pass "full FFI release build"
FULL="target/release/libshawncore_ffi.a"
if [[ ! -f "$FULL" ]]; then FULL="target/release/libshawncore_ffi.rlib"; fi
[[ -f "$FULL" ]] && printf '[release-gate] full artifact bytes: %s\n' "$(stat -c '%s' "$FULL")"
python3 - <<'PY2'
import json, subprocess
m=json.loads(subprocess.check_output(["cargo","metadata","--no-deps","--format-version","1"],text=True))
p=next(x for x in m["packages"] if x["name"]=="shawncore-pq-crypto")
print("[release-gate] PQ features:", ", ".join(sorted(p.get("features",{}))))
raise SystemExit(0 if "lite" in p.get("features",{}) else 1)
PY2
then
  log "Lite PQ build"; cargo build -p shawncore-pq-crypto --no-default-features --features lite --profile lite; pass "Lite PQ build"
  log "Lite FFI build"; cargo build -p shawncore-ffi --no-default-features --features lite --profile lite; pass "Lite FFI build"
  LITE="target/lite/libshawncore_ffi.a"; [[ -f "$LITE" ]] || LITE="target/lite/libshawncore_ffi.rlib"
  [[ -f "$LITE" ]] && printf '[release-gate] lite artifact bytes: %s\n' "$(stat -c '%s' "$LITE")"
  NM=""; command -v llvm-nm >/dev/null 2>&1 && NM=llvm-nm; [[ -n "$NM" ]] || { command -v nm >/dev/null 2>&1 && NM=nm || true; }
  if [[ -n "$NM" && -f "$FULL" && -f "$LITE" ]]; then
    "$NM" "$LITE" | grep -q 'shawncore_crypto_ml_dsa_' && fail "Lite artifact contains ML-DSA FFI symbols"
    "$NM" "$FULL" | grep -q 'shawncore_crypto_ml_dsa_' || fail "Full artifact lacks expected ML-DSA FFI symbols"
    pass "Full/Lite ML-DSA symbol boundary"
  fi
fi
pass "RELEASE GATE PASSED"
